RESUME_ENVIRONMENT=development
RESUME_METADATA_BACKEND=memory
RESUME_DATA_DIR=../.local/sessions
RESUME_ALLOWED_ORIGINS=["http://127.0.0.1:4321","http://localhost:4321"]
# Production requires Redis, HTTPS cookies, and a non-default random IP hash salt.
# RESUME_REDIS_URL=redis://127.0.0.1:6379/1
# RESUME_IP_SALT=replace-with-a-long-random-value
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RESUME_DATA_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Station-owned model: an administrator configures all three together.
# RESUME_LLM_BASE_URL=https://your-approved-provider.example/v1
# RESUME_LLM_MODEL=your-model
# RESUME_LLM_API_KEY=your-key
# Optional, private bearer token for /admin/stats
# RESUME_ADMIN_TOKEN=your-admin-token
