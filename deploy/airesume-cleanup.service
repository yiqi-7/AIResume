[Unit]
Description=AIResume cleanup sweep through the running API
After=airesume.service

[Service]
Type=oneshot
User=airesume
Group=airesume
EnvironmentFile=/etc/airesume/api.env
ExecStart=/opt/airesume/api/.venv/bin/python /opt/airesume/deploy/cleanup.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
