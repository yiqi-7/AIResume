RESUME_ENVIRONMENT=production
RESUME_METADATA_BACKEND=redis
RESUME_REDIS_URL=redis://127.0.0.1:6379/1
RESUME_DATA_DIR=/var/lib/airesume/sessions
RESUME_ALLOWED_ORIGINS=["https://key123456.online"]
RESUME_IP_SALT=REPLACE_WITH_RANDOM_SECRET
RESUME_DATA_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
RESUME_ADMIN_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_SECRET
# Configure only after confirming provider privacy terms and available model IDs.
# RESUME_LLM_BASE_URL=https://approved-provider.example/v1
# RESUME_LLM_MODEL=approved-model
# RESUME_LLM_PROTOCOL=chat_completions
# RESUME_LLM_OUTPUT_TOKENS=8192
# RESUME_LLM_REASONING_EFFORT=low
# RESUME_LLM_API_KEY=operator-configured-secret

# Start with one uvicorn worker and 2 simultaneous analysis tasks.
RESUME_MAX_ACTIVE_JOBS=2
RESUME_MAX_ACTIVE_UPLOADS=1
RESUME_UPLOAD_TIMEOUT=60
RESUME_PAGECHECK_SOCKET=/run/airesume-pagecheck.sock
