---
import Layout from '../layouts/Layout.astro';
import { ArrowUpRight } from 'lucide-react';
---
<Layout title="叙职 AIResume — 简历优化工具">
  <div class="landing">
    <header class="site-header page-width">
      <a class="brand" href="/" aria-label="叙职首页"><span class="brand-symbol" aria-hidden="true"><span></span><span></span><span></span></span><strong>叙职</strong><span class="brand-en">AIResume</span></a>
      <nav aria-label="主导航"><a href="#how-it-works">如何修改</a><a href="/privacy/">隐私说明</a><a class="nav-start" href="/app/">打开工作台<ArrowUpRight size={15} /></a></nav>
    </header>
    <main id="main">
      <section class="hero page-width">
        <div class="hero-copy">
          <h1>根据目标岗位，修改你的简历。</h1>
          <p class="hero-description">上传简历和岗位描述，逐条核对修改建议，导出可编辑的 Word。</p>
          <div class="hero-actions"><a class="button primary large" href="/app/">开始修改简历<ArrowUpRight size={18} /></a><a class="text-link" href="/app/?demo=1">先看一个例子</a></div>
        </div>
        <div class="hero-stage" aria-label="虚构简历的改写示例">
          <div class="stage-tab">改写示例</div>
          <div class="hero-paper">
            <div class="paper-person"><span>陈同学</span><small>应届毕业生 / 产品经理方向</small></div>
            <div class="paper-rule"></div><p class="paper-section">项目经历</p>
            <h2>校园二手交易平台</h2><p class="paper-date">课程项目 · 需求分析与原型设计</p>
            <div class="before-copy"><span class="margin-label">原文</span><p>访谈同学并整理需求，梳理发布和检索流程，完成平台原型。</p></div>
            <div class="after-copy"><span class="margin-label">改写</span><p>围绕校园二手交易场景，<mark>访谈同学并整理需求</mark>；梳理物品发布与检索流程，<mark>输出产品原型</mark>。</p></div>
          </div>
          <div class="jd-strip"><span>岗位要求</span><p>“能够进行需求分析，并将需求转化为产品原型。”</p></div>
        </div>
      </section>
      <section id="how-it-works" class="process-section" aria-label="使用步骤">
          <ol class="page-width process-list">
            <li><span class="process-number" aria-hidden="true">1</span><h2>上传简历与岗位描述</h2></li>
            <li><span class="process-number" aria-hidden="true">2</span><h2>逐条修改</h2></li>
            <li><span class="process-number" aria-hidden="true">3</span><h2>导出 Word</h2></li>
          </ol>
      </section>
    </main>
    <footer class="site-footer page-width"><a class="brand small" href="/"><strong>叙职</strong><span class="brand-en">AIResume</span></a><a href="/privacy/">隐私说明</a></footer>
  </div>
</Layout>
